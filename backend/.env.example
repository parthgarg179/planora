# Copy this file to .env (same folder) and fill in your values.

# PostgreSQL connection: postgresql+psycopg://USER:PASSWORD@localhost:5432/DATABASE
DATABASE_URL=postgresql+psycopg://planora:planora@localhost:5432/planora

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# How long a login lasts, in minutes (10080 = 7 days)
TOKEN_EXPIRE_MINUTES=10080

# Google Gemini (get a key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Check the model list in Google AI Studio if this name stops working
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=120

# Days a missed end-of-day review can still be filled in
REVIEW_LOOKBACK_DAYS=3

# Only needed if you also open the frontend from Live Server
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: pretend "today" is this date (YYYY-MM-DD) for demos and testing missed days
PLANORA_TODAY=

# Time zone for "today", missed days and reminder times (e.g. Asia/Kolkata).
# Leave empty to use this computer's local time; set it on servers, which run on UTC.
APP_TIMEZONE=

# Demo account created by `python -m scripts.seed_demo` (never commit real values)
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME=
